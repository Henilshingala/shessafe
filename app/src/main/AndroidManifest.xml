<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS permissions for OTP and SOS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    
    <!-- Foreground service + notifications for receiver-side alert -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Special use foreground service for emergency alerts (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- Notification permissions (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Full screen intent for emergency alerts (Android 14+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    
    <!-- Vibration permission for SOS alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Audio permissions for emergency sounds -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- Wake lock to keep device awake during emergency -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Schedule exact alarms (Android 12+) for reliable timing -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <!-- Request battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    
    <!-- Boot receiver for direct boot mode -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.telephony.sms"
        android:required="false" />

    <permission
        android:name="com.womensafety.app.permission.SOS_TRIGGER"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.WomenSafetyApp"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WomenSafetyApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen emergency alert activity -->
        <activity
            android:name=".EmergencyAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/Theme.WomenSafetyApp">
            <intent-filter>
                <action android:name="com.womensafety.app.ACTION_SHOW_EMERGENCY_ALERT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- SOS Broadcast Receiver for sending alerts -->
        <receiver
            android:name=".receiver.SOSBroadcastReceiver"
            android:exported="true"
            android:permission="com.womensafety.app.permission.SOS_TRIGGER">
            <intent-filter>
                <action android:name="com.womensafety.app.SOS_TRIGGER" />
            </intent-filter>
        </receiver>
        
        <!-- SOS Alert Receiver for receiving emergency messages -->
        <receiver
            android:name=".receiver.SOSAlertReceiver"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service to play buzzer + vibration on receiver device -->
        <service
            android:name=".receiver.SOSAlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Emergency alert service for safety notifications" />
        </service>

        <!-- Foreground service to forward IoT SOS alerts to emergency contacts -->
        <service
            android:name=".receiver.IoTSOSForwardingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="IoT emergency alert forwarding service" />
        </service>

    </application>

</manifest>
